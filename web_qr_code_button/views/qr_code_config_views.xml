<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_qr_code_button_config_list" model="ir.ui.view">
        <field name="name">qr_code_button.config.list</field>
        <field name="model">qr_code_button.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_qr_code_button_config_form" model="ir.ui.view">
        <field name="name">qr_code_button.config.form</field>
        <field name="model">qr_code_button.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="model_id"/>
                        <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        Once saved, a "Show QR Code" action appears in the gear (Actions) menu
                        of this model's form view.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qr_code_button_config" model="ir.actions.act_window">
        <field name="name">QR Code Button</field>
        <field name="res_model">qr_code_button.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first QR Code setup</p>
            <p>Pick a model: a "Show QR Code" action will appear on that model's form view.</p>
        </field>
    </record>

    <menuitem id="menu_qr_code_button_config"
              name="QR Code Button"
              parent="base.next_id_2"
              action="action_qr_code_button_config"
              groups="base.group_system"
              sequence="61"/>

</odoo>

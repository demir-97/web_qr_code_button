<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="qr_code_print_page" name="QR Code Print">&lt;!DOCTYPE html&gt;
<html>
    <head>
        <meta charset="utf-8"/>
        <title t-out="record_name"/>
        <style>
            * { box-sizing: border-box; }
            html, body {
                margin: 0;
                height: 100%;
                font-family: -apple-system, Helvetica, Arial, sans-serif;
            }
            .qr-print-page {
                height: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }
            .qr-print-page h1 {
                font-size: 18px;
                font-weight: 600;
                margin: 0 0 20px;
            }
            .qr-print-page img {
                width: 320px;
                height: 320px;
            }
            @media print {
                @page { margin: 24mm; }
            }
        </style>
    </head>
    <body>
        <div class="qr-print-page">
            <h1 t-out="record_name"/>
            <img t-attf-src="data:image/png;base64,#{qr_image}"/>
        </div>
        <script>
            window.addEventListener('load', function () { window.print(); });
        </script>
    </body>
</html>
    </template>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_qr_code_button_wizard_form" model="ir.ui.view">
        <field name="name">qr_code_button.wizard.form</field>
        <field name="model">qr_code_button.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="text-center">
                        <h3><field name="record_name" readonly="1" nolabel="1"/></h3>
                        <field name="qr_image" widget="image" nolabel="1" options="{'size': [300, 300]}"/>
                        <div class="text-muted mt-2">
                            <field name="qr_value" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button name="action_download" string="Download" type="object" class="btn-secondary"/>
                    <button string="Close" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
